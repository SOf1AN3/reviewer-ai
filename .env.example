# ============================================================================
# PaperNote — Variables d'environnement (exemple)
# Copier ce fichier vers `.env.local` puis remplir les valeurs.
# AUCUNE valeur secrète réelle ne doit être commitée (`.env*` est ignoré par git).
# ============================================================================

# --- Base de données (Prisma / PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/papernote?schema=public"

# --- Auth (NextAuth v5)
# AUTH_SECRET : secret de chiffrement des sessions/jetons.
# Générer avec : openssl rand -base64 32
AUTH_SECRET="generer-avec: openssl rand -base64 32"
# URL publique de l'app (callbacks OAuth, etc.)
AUTH_URL="http://localhost:3000"

# --- OAuth Google (optionnel en dev : le login Google est désactivé si absent)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- IA (Google Gemini)
GEMINI_API_KEY=""

# --- Email (Resend) — OPTIONNEL en dev, REQUIS en production.
# Optionnelle en dev : l'envoi d'email devient un NO-OP SILENCIEUX (aucune
# erreur, aucun crash — un événement structuré « email skipped » est loggué)
# et la vérification email est BYPASSEE automatiquement à l'inscription.
# En production, cette clé est EXIGEE au démarrage (sinon erreur explicite) et
# l'expéditeur doit utiliser un domaine vérifié Resend (champ `from`).
# Obtenir une clé : https://resend.com/api-keys — NE JAMAIS committer de vraie clé.
RESEND_API_KEY=""

# --- Stripe — MODE TEST
# OBTENTION DU WEBHOOK SECRET (en local) :
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
#   puis copier le whsec_... affiché ci-dessous.
# STRIPE_PRO_PRICE_ID / STRIPE_BUSINESS_PRICE_ID : créer 2 produits/prix dans le
# dashboard Stripe (mode test) puis coller les price_... ici.
# En dev, si absents, l'app crée les produits/prix dynamiquement (fallback).
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRO_PRICE_ID=""
STRIPE_BUSINESS_PRICE_ID=""
# Optionnelle : prioritaire sur NEXT_PUBLIC_APP_URL côté API (Stripe checkout/portal)
# NEXT_APP_URL="http://localhost:3000"

# --- App
# URL publique de l'application (redirections Stripe checkout/portal).
# Variante serveur optionnelle : NEXT_APP_URL (prioritaire côté API si définie).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
